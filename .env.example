# Application
APP_NAME="AI TravelDesk"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (PostgreSQL 16)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=traveldesk
POSTGRES_PASSWORD=traveldesk_dev_password
POSTGRES_DB=ai_traveldesk
DATABASE_URL=postgresql+asyncpg://traveldesk:traveldesk_dev_password@localhost:5432/ai_traveldesk
DATABASE_URL_SYNC=postgresql+psycopg://traveldesk:traveldesk_dev_password@localhost:5432/ai_traveldesk

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET_KEY=change-me-to-a-64-char-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="AI TravelDesk"

# AI & External Providers (Sandbox / Future Phases)
OPENAI_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
DUFFEL_ACCESS_TOKEN=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
BKASH_APP_KEY=
STRIPE_SECRET_KEY=
